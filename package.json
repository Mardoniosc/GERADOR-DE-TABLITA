{
  "name": "gerador-de-tablita",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "import:tablitas": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/import-tablitas.ts",
    "serve:prod": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/serve-dist.ts",
    "icons": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-icons.ts",
    "build:pages": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-pages.ts",
    "verify:dist": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-dist.ts"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@10.9.3",
  "dependencies": {
    "@angular/common": "~21.0.2",
    "@angular/compiler": "~21.0.2",
    "@angular/core": "~21.0.2",
    "@angular/forms": "~21.0.2",
    "@angular/platform-browser": "~21.0.2",
    "@angular/router": "~21.0.2",
    "@angular/service-worker": "~21.0.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "~21.0.2",
    "@angular/cli": "~21.0.2",
    "@angular/compiler-cli": "~21.0.2",
    "jsdom": "^27.1.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "config": {
    "pagesBaseHref": ""
  }
}
